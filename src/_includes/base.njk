<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.domain }}{{ canonical }}">
  <meta name="robots" content="index, follow">
  <meta property="og:type" content="{{ ogType or "website" }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.domain }}{{ canonical }}">
  <meta property="og:image" content="{{ site.domain }}/assets/img/og-image.jpg">
  <meta property="og:locale" content="uk_UA">
  <meta property="og:site_name" content="{{ site.name }} — {{ site.role }} у {{ site.city }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.domain }}/assets/img/og-image.jpg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16.png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=Marck+Script&family=Mulish:wght@400;600;700;800&subset=cyrillic&display=swap" rel="stylesheet">
  {% block head_extra %}{% endblock %}
</head>
<body>
  {% include "header.njk" %}
  <main id="main">
{% block content %}{% endblock %}
  </main>
  {% include "footer.njk" %}
  <script src="/assets/js/main.js"></script>
</body>
</html>
