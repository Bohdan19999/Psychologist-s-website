<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/assets/img/logo.png" alt="" width="38" height="38">
          <span>{{ site.name }}</span>
        </div>
        <p>Психолог у {{ site.city }}. Очні консультації та онлайн — для клієнтів по всій Україні та за кордоном.</p>
        <div class="footer-social">
          <a href="{{ site.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{{ icons.instagram | safe }}</a>
          <a href="{{ site.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{{ icons.facebook | safe }}</a>
          <a href="{{ site.telegramUrl }}" aria-label="Telegram" target="_blank" rel="noopener">{{ icons.telegram | safe }}</a>
        </div>
      </div>
      <div>
        <h4>Розділи</h4>
        <ul class="footer-links">
          <li><a href="/pro-mene/">Про мене</a></li>
          <li><a href="/posluhy/">Послуги</a></li>
          <li><a href="/tsiny/">Ціни</a></li>
          <li><a href="/vidguky/">Відгуки</a></li>
          <li><a href="/blog/">Блог</a></li>
        </ul>
      </div>
      <div>
        <h4>Формати роботи</h4>
        <ul class="footer-links">
          <li><a href="/onlayn-konsultatsii/">Онлайн-консультації</a></li>
          <li><a href="/dlya-ukraintsiv-za-kordonom/">Для українців за кордоном</a></li>
          <li><a href="/kontakty/">Очно в {{ site.city }}</a></li>
        </ul>
      </div>
      <div>
        <h4>Контакти</h4>
        <ul class="footer-links">
          <li><a href="{{ site.phoneHref }}">{{ site.phoneDisplay }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>{{ site.address }}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ site.year }} {{ site.name }}. Усі права захищено.</span>
      <a href="/pryvasi-polisy/">Політика конфіденційності</a>
    </div>
  </div>
</footer>
