---
active: "tsiny"
permalink: "/tsiny/"
canonical: "/tsiny/"
eleventyComputed:
  title: "{{ pages['tsiny'].seo_title }}"
  description: "{{ pages['tsiny'].seo_description }}"
---
{% extends "base.njk" %}
{% import "macros.njk" as m with context %}
{% set p = pages["tsiny"] %}
{% set faq = [
  {"question": "Як оплатити консультацію?", "answer": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent nec lectus non arcu tempor cursus. Vivamus feugiat, lorem sit amet dictum vehicula, urna erat ultrices metus, id porttitor turpis erat ac sapien."},
  {"question": "Чи є знижки на пакети консультацій?", "answer": "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum."},
  {"question": "Що робити, якщо потрібно скасувати чи перенести сесію?", "answer": "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt."}
] %}

{% block head_extra %}
{% faqJsonLd faq %}
{% breadcrumbJsonLd [{"label": "Головна", "href": "/"}, {"label": "Ціни", "href": "/tsiny/"}] %}
{% endblock %}

{% block content %}
<header class="page-header">
  <div class="container">
    {{ m.breadcrumbs([{"label": "Головна", "href": "/"}, {"label": "Ціни"}]) }}
    <span class="eyebrow">Вартість</span>
    <h1>Ціни та формат консультацій</h1>
    <p class="lede">{{ p.lede }}</p>
  </div>
</header>
<div class="container">
  <section class="std-section">
    <div class="table-scroll">
      <table class="pricing-table">
        <thead><tr><th>Послуга</th><th>Вартість</th></tr></thead>
        <tbody>
          <tr><td>Індивідуальна консультація, очно ({{ site.city }})</td><td>1200&nbsp;грн</td></tr>
          <tr><td>Індивідуальна консультація, онлайн</td><td>1000&nbsp;грн</td></tr>
          <tr><td>Пакет 4 консультації, онлайн</td><td>3600&nbsp;грн</td></tr>
          <tr><td>Консультація для українців за кордоном</td><td>40&nbsp;€</td></tr>
        </tbody>
      </table>
    </div>
    <p class="price-note">Ціни орієнтовні (плейсхолдер) і будуть уточнені. Тривалість консультації — 50 хвилин.</p>
  </section>
  <section class="std-section">{{ p.bodyHtml | safe }}</section>
  {{ m.faqBlock(faq) }}
  <section class="std-section">
    {{ m.ctaBlock("Записатись на консультацію", "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium.") }}
  </section>
</div>
{% endblock %}
