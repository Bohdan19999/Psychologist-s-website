---
active: "pro-mene"
permalink: "/pro-mene/"
canonical: "/pro-mene/"
eleventyComputed:
  title: "{{ pages['pro-mene'].seo_title }}"
  description: "{{ pages['pro-mene'].seo_description }}"
---
{% extends "base.njk" %}
{% import "macros.njk" as m with context %}
{% set p = pages["pro-mene"] %}

{% block head_extra %}
{% personJsonLd %}
{% breadcrumbJsonLd [{"label": "Головна", "href": "/"}, {"label": "Про мене", "href": "/pro-mene/"}] %}
{% endblock %}

{% block content %}
<header class="page-header">
  <div class="container">
    {{ m.breadcrumbs([{"label": "Головна", "href": "/"}, {"label": "Про мене"}]) }}
    <span class="eyebrow">Про мене</span>
    <h1>Знайомтесь, я {{ site.name }}</h1>
    <p class="lede">{{ p.lede }}</p>
  </div>
</header>

<section class="std-section">
  <div class="container contact-grid">
    <div class="figure-card figure-card--photo" style="aspect-ratio:3/4;width:100%;">
      <picture>
        <source srcset="/assets/img/valentyna-svatkova.webp" type="image/webp">
        <img src="/assets/img/valentyna-svatkova.jpg" alt="{{ site.name }} — клінічний психолог у {{ site.city }}" width="860" height="1280">
      </picture>
    </div>
    <div>{{ p.bodyHtml | safe }}</div>
  </div>
</section>

<section class="std-section">
  <div class="container">
    {{ m.ctaBlock("Записатись на консультацію", "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent nec lectus non arcu tempor cursus.") }}
  </div>
</section>
{% endblock %}
