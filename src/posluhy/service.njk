---
pagination:
  data: "services"
  size: 1
  alias: "item"
permalink: "/posluhy/{{ item.slug }}/"
active: "posluhy"
eleventyComputed:
  canonical: "/posluhy/{{ item.slug }}/"
  title: "{{ item.title }} — Валентина Сваткова, психолог у Черкасах"
  description: "{{ item.keyword }}: індивідуальні консультації з Валентина Сваткова, психологом у Черкасах. Очно та онлайн. Записатись на консультацію."
---
{% extends "base.njk" %}
{% import "macros.njk" as m with context %}

{% block head_extra %}
{% faqJsonLd item.faq %}
{% breadcrumbJsonLd [{"label": "Головна", "href": "/"}, {"label": "Послуги", "href": "/posluhy/"}, {"label": item.title, "href": "/posluhy/" + item.slug + "/"}] %}
{% endblock %}

{% block content %}
<article>
  <header class="page-header">
    <div class="container">
      {{ m.breadcrumbs([{"label": "Головна", "href": "/"}, {"label": "Послуги", "href": "/posluhy/"}, {"label": item.title}]) }}
      {{ m.iconCircle(item.icon, "margin-bottom:1rem;") }}
      <h1>{{ item.title }}</h1>
      <p class="lede">{{ item.lede }}</p>
    </div>
  </header>

  <div class="container">
    <section class="symptoms">
      <h2>Коли варто звернутись</h2>
      {{ item.symptomsHtml | safe }}
    </section>

    <section class="approach">
      <h2>Як проходить робота</h2>
      {{ item.approachHtml | safe }}
    </section>

    <section class="results">
      <h2>Що зміниться після роботи</h2>
      {{ item.resultsHtml | safe }}
    </section>

    {{ m.faqBlock(item.faq) }}

    {% if item.related and item.related.length %}
    <section class="std-section">
      <h2>Пов'язані послуги</h2>
      {{ m.relatedServices(item.related, services) }}
    </section>
    {% endif %}

    {{ m.ctaBlock("Записатись на консультацію", "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent nec lectus non arcu tempor cursus.") }}
  </div>
</article>
{% endblock %}
